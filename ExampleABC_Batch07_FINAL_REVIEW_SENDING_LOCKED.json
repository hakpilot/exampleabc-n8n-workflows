        "jsCode": "\nconst m=$input.item.json;const idx=$('Loop One Email At A Time').context.currentRunIndex;let c;try{c=$('Loop One Email At A Time').item.json;}catch(e){c=$('Block if ANY prior Gmail match').all()[idx]?.json;}\nif(!m.id||!m.threadId||!c||c.authorized_to_send!==true||c.approved_batch!=='BATCH07-20261027'||Number(c.prospect_id)<76||Number(c.prospect_id)>95)throw Error('Gmail message ID/recipient index unresolved; stop without logging send. Search Gmail before any retry.');\nconst sent_at=new Date().toLocaleString('en-US',{timeZone:'America/New_York',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});\nreturn {json:{...c,gmail_message_id:m.id,gmail_thread_id:m.threadId||'',sent_at}};\n"
