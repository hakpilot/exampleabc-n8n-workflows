      "id": "note",
      "name": "READ ME - single use approved batch",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        550,
        10
      ],
      "parameters": {
        "content": "## BATCH 07 — LOCKED. Oct 27 proposed 08:00 Eastern.\n\nFresh prospects #76–95. Every outbound message must use the explicit Gmail API MIME From: hyder@exampleabc.com, To exactly one reviewed recipient, no Cc/Bcc. Sending and all Sheets writes disabled; no auto/manual trigger. A separate signed one-time release may be created after final checks, exact source approval and review. Do not activate this source.\n\nOct 26: GitHub-only locked deployment requested. No emails may be sent; no workflows activated.",
        "width": 1300,
        "height": 260
      }
    },
    {
      "id": "audit2",
      "name": "Require 20 Gmail IDs From Final Ledger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3890,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const expected=new Set([76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95]);\nconst matched=$input.all().map(item=>item.json).filter(r=>r['Batch ID']==='BATCH07-20261027');\nconst unique=new Map();\nfor(const row of matched){\n const id=Number(row['Prospect #']);\n if(!expected.has(id))throw Error('Unexpected prospect in batch ledger: '+id);\n if(row[\"Status\"]!=='SENT'||!String(row[\"Gmail Message ID\"]||'').trim()||!String(row[\"Sent At ET\"]||'').trim())throw Error('Incomplete send ledger row #'+id);\n const prior=unique.get(id);\n if(prior&&String(prior[\"Gmail Message ID\"])!==String(row[\"Gmail Message ID\"]))throw Error('Conflicting Gmail IDs for prospect #'+id);\n unique.set(id,row);\n}\nif(unique.size!==expected.size)throw Error('Missing confirmed unique ledger IDs; got '+unique.size+' of '+expected.size);\nreturn [{json:{'Batch ID':'BATCH07-20261027',Approval:'COMPLETE','Last Run':new Date().toISOString()}}];"
      }
    },
    {
      "id": "explicitMimeInitial",
      "name": "Build Strict ExampleABC Initial MIME",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3740,
        430
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst c=$input.item.json;\nconst from='hyder@exampleabc.com';\nconst to=String(c.to||'').trim().toLowerCase();\nconst subject=String(c.subject||'').trim(),body=String(c.body||'');\nif(c.authorized_to_send!==true||c.approved_batch!=='BATCH07-20261027'||Number(c.prospect_id)<76||Number(c.prospect_id)>95)throw Error('Unapproved initial recipient');\nif(!/^[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}$/i.test(to)||to==='hyder@exampleabc.com'||to==='hyder@hiratechnologies.net'||to==='hakpilot@gmail.com')throw Error('Forbidden destination');\nif(!subject||/[\\r\\n]/.test(subject)||!body.toLowerCase().includes('unsubscribe'))throw Error('Invalid outgoing MIME content');\nconst encodedSubject=/[^\\x00-\\x7F]/.test(subject)?'=?UTF-8?B?'+Buffer.from(subject,'utf8').toString('base64')+'?=':subject;\nconst mime=[\n 'From: Hyder Khan <'+from+'>',\n 'To: '+to,\n 'Subject: '+encodedSubject,\n 'MIME-Version: 1.0',\n 'Content-Type: text/plain; charset=UTF-8',\n 'Content-Transfer-Encoding: 8bit',\n '',\n body\n].join('\\r\\n');\nconst raw=Buffer.from(mime,'utf8').toString('base64').replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');\nreturn {json:{...c,raw,explicit_from:from,explicit_to:to}};\n"
      }
    }
