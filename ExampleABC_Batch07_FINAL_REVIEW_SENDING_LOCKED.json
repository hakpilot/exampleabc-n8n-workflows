    {
      "id": "nopr",
      "name": "Block if ANY prior Gmail match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3250,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst q=$('Prepare Queue and Gmail Search').first().json;\nconst gmail=$input.all().map(i=>i.json).filter(m=>m.id||m.threadId);\nif(gmail.length){const ambiguous=[];const matches=[];for(const m of gmail){const s=JSON.stringify(m).toLowerCase();const hits=q.candidates.filter(c=>s.includes(c.to));if(!hits.length)ambiguous.push(m.id||m.threadId);else matches.push(...hits.map(h=>h.prospect_id));}\nthrow Error('Gmail reconciliation HOLD: prior emails/messages found. Matches='+[...new Set(matches)].join(',')+'; ambiguous='+ambiguous.length+'. No prospect sends authorized.');}\nreturn q.candidates.map(c=>({json:{...c,authorized_to_send:true,approved_batch:'BATCH07-20261027'}}));\n"
      }
