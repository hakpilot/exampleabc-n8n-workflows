    {
      "id": "check",
      "name": "Fail Closed on Replies or Additional Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst t=$input.item.json;\nconst c=$('Loop One Followup At A Time').item.json;\nconst msgs=Array.isArray(t.messages)?t.messages:[];\nif(t.id!==c.orig_thread_id||msgs.length!==1||msgs[0].id!==c.orig_message_id)throw Error('Thread changed since review; no follow-up to '+c.to);\nconst labels=msgs[0].labelIds||[];\nif(!labels.includes('SENT'))throw Error('Original not confirmed as SENT: '+c.to);\nreturn {json:{...c,verified:true}};\n"
      }
    },
