    {
      "id": "note",
      "name": "REVIEW NOTE: Never auto-enable Gmail reply",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        350,
        -120
      ],
      "parameters": {
        "content": "## THREAD REPLIES: LOCKED UNTIL QA\nThis workflow is review-only. All write and Gmail reply nodes are deactivated; Batch34 Followup Control = HOLD. Do not enable until Gmail Reply tested with an **outgoing** original message to ensure only intended recipient gets email and the same thread is used. Each follow-up's original Gmail message and thread IDs are in Batch34 Followup Log. Only 16 eligible prospects; four known exceptions excluded. Never blindly rerun after partial send.\n\nQA5 confirmed Gmail message reply to a SENT original preserved its thread and included the original recipient (reply-all added an internal self-copy). Final follow-up completion now re-reads persisted Send Log Gmail IDs.\n\nOCT26 INCIDENT REMEDIATION: native Gmail Reply removed. Explicit MIME Gmail API reply with From: hyder@exampleabc.com and To: verified original prospect ONLY, plus original Message-ID and threadId. Self-owned QA12 confirmed matching thread and headers. HTTP POST is HARD DISABLED. Must pass production-preview QA and be explicitly reapproved before any future release.",
        "width": 1500,
        "height": 260
      }
    },
    {
      "id": "audit2-followups",
      "name": "Require 16 Confirmed Followup Gmail IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3430,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const expected=new Set([21,22,23,26,27,28,30,32,33,34,35,36,37,38,39,40]);\nconst matched=$input.all().map(item=>item.json).filter(r=>r['Batch ID']==='BATCH34-FOLLOWUP-20261023');\nconst unique=new Map();\nfor(const row of matched){\n const id=Number(row['Prospect #']);\n if(!expected.has(id))throw Error('Unexpected prospect in batch ledger: '+id);\n if(row[\"Send Status\"]!=='SENT'||!String(row[\"Follow-up Gmail ID\"]||'').trim()||!String(row[\"Follow-up Sent ET\"]||'').trim())throw Error('Incomplete send ledger row #'+id);\n const prior=unique.get(id);\n if(prior&&String(prior[\"Follow-up Gmail ID\"])!==String(row[\"Follow-up Gmail ID\"]))throw Error('Conflicting Gmail IDs for prospect #'+id);\n unique.set(id,row);\n}\nif(unique.size!==expected.size)throw Error('Missing confirmed unique ledger IDs; got '+unique.size+' of '+expected.size);\nreturn [{json:{'Batch ID':'BATCH34-FOLLOWUP-20261023',Approval:'COMPLETE','Last Run':new Date().toISOString()}}];"
      }
    },
