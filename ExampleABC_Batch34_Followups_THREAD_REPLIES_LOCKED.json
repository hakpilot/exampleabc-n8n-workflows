      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3350,
        420
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst original=$input.item.json;\nconst c=$('Fail Closed on Replies or Additional Messages').item.json;\nconst from='hyder@exampleabc.com';\nconst to=String(c.to||'').trim().toLowerCase();\nif(c.verified!==true||!c.orig_message_id||!c.orig_thread_id||original.id!==c.orig_message_id||original.threadId!==c.orig_thread_id)throw Error('Original Gmail message/thread ID changed; do not reply');\nif(!/^[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}$/i.test(to)||['hyder@exampleabc.com','hyder@hiratechnologies.net','hakpilot@gmail.com'].includes(to))throw Error('Unsafe reply recipient');\nconst headers=Array.isArray(original.payload?.headers)?original.payload.headers:[];\nconst getHeader=(name)=>String(headers.find(h=>String(h.name||'').toLowerCase()===name.toLowerCase())?.value||'').trim();\nconst origFrom=getHeader('From'),origTo=getHeader('To'),origSubject=getHeader('Subject');\nconst messageId=getHeader('Message-ID'),refs=getHeader('References');\nconst originalToAddresses=(origTo.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi)||[]).map(v=>v.toLowerCase());\nif(!origFrom.toLowerCase().includes(from)||originalToAddresses.length!==1||originalToAddresses[0]!==to)throw Error('Original From/To does not match verified ExampleABC -> prospect conversation');\nif(!/^<[^<>\\r\\n\\s]+>$/.test(messageId)||/[\\r\\n]/.test(origSubject)||!origSubject||/[\\r\\n]/.test(refs))throw Error('Invalid RFC822 original headers');\nconst subject=/^re:/i.test(origSubject)?origSubject:'Re: '+origSubject;\nconst encodedSubject=/[^\\x00-\\x7F]/.test(subject)?'=?UTF-8?B?'+Buffer.from(subject,'utf8').toString('base64')+'?=':subject;\nconst body=String(c.body||'');\nif(!body.trim()||!body.toLowerCase().includes('unsubscribe'))throw Error('Missing first-followup template or opt-out');\nconst references=(refs?refs+' ':'')+messageId;\nconst mime=[\n 'From: Hyder Khan <'+from+'>',\n 'To: '+to,\n 'Subject: '+encodedSubject,\n 'In-Reply-To: '+messageId,\n 'References: '+references,\n 'MIME-Version: 1.0',\n 'Content-Type: text/plain; charset=UTF-8',\n 'Content-Transfer-Encoding: 8bit',\n '',\n body\n].join('\\r\\n');\nconst raw=Buffer.from(mime,'utf8').toString('base64').replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');\nreturn {json:{...c,raw,explicit_from:from,explicit_to:to,original_thread_id:c.orig_thread_id}};\n"
      }
