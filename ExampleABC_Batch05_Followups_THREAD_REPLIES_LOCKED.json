    {
      "id": "audit2-followups",
      "name": "Require 15 Confirmed Followup Gmail IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3430,
        90
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows=$input.all().map(i=>i.json).filter(x=>x[\"Batch ID\"]===\"BATCH05-FOLLOWUP-20261026\");\nconst ids=new Set(rows.map(x=>Number(x[\"Prospect #\"])));\nif(rows.length!==15||ids.size!==15)throw Error(\"Followup ledger size changed; cannot mark complete.\");\nfor(let id=41;id<=55;id++){if(!ids.has(id))throw Error('Batch05 missing prospect #'+id);}\nfor(const r of rows){\nif(r[\"Send Status\"]!==\"SENT\"||!String(r[\"Follow-up Gmail ID\"]||\"\").trim()||!String(r[\"Follow-up Sent ET\"]||\"\").trim())throw Error(\"Unlogged follow-up #\"+r[\"Prospect #\"]);\n}\nreturn [{json:{\"Batch ID\":\"BATCH05-FOLLOWUP-20261026\",Approval:\"COMPLETE\",\"Last Run\":new Date().toISOString()}}];"
      }
    }
