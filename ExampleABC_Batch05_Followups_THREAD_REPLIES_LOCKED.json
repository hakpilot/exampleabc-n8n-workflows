    {
      "id": "prepare",
      "name": "Build Verified Thread Reply Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst P=$('Store Prospects').first().json.rows,D=$('Store Drafts').first().json.rows,X=$('Store Exceptions').first().json.rows,L=$input.all().map(i=>i.json);\nconst n=r=>Number(r['#']??r['Prospect #']);const t=v=>String(v??'').trim();const em=v=>t(v).toLowerCase();\nconst pm=new Map(P.map(v=>[n(v),v])),dm=new Map(D.map(v=>[n(v),v])),ex=new Set(X.map(v=>Number(v.Prospect)));\nconst fail=[],queue=[];\nfor(const l of L){\n const id=n(l),p=pm.get(id),d=dm.get(id),issues=[],body=t(d?.['Follow-up Template']),to=em(l.Recipient);\n if(id<41||id>55)issues.push('Prospect not in approved Batch05 range 41-55');\n if(!p||!d)issues.push('Missing prospect/draft');\n if(!/^[0-9a-f]{16,}$/.test(t(l['Original Gmail Message ID']))||!t(l['Original Thread ID']))issues.push('Original Gmail message/thread ID absent');\n if(p?.Status!=='Sent'||t(p?.['Follow-up Date'])||t(p?.['Reply Date']))issues.push('Prospect not currently eligible');\n if(t(l['Send Status'])!=='PENDING'||t(l['Follow-up Gmail ID']))issues.push('Follow-up already processed');\n if(t(l['Review Status'])!=='READY')issues.push('Held by reviewer');\n if(to!==em(p?.['Public Email'])||to!==em(d?.['Send To']))issues.push('Email mismatch');\n if(!body||!body.toLowerCase().includes('unsubscribe'))issues.push('Template invalid');\n if(ex.has(id)||[24,25,29,31].includes(id))issues.push('Blocked contact');\n if(issues.length)fail.push('#'+id+': '+issues.join(','));\n else queue.push({id,to,body,orig_message_id:l['Original Gmail Message ID'],orig_thread_id:l['Original Thread ID'],batch_id:'BATCH05-FOLLOWUP-20261026'});\n}\nif(fail.length||queue.length!==15)throw Error('Follow-up send ABORT '+fail.join('|')+' candidates='+queue.length);\nreturn queue.map(x=>({json:x}));\n"
      }
    },
