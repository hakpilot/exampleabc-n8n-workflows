    {
      "id": "query",
      "name": "Prepare Queue and Gmail Search",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2780,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst P=$('Store Prospects').first().json.rows,D=$('Store Drafts').first().json.rows,X=$('Store Exceptions').first().json.rows,L=$input.all().map(i=>i.json);\nconst n=r=>Number(r['#']??r['Prospect #']);const txt=v=>String(v??'').trim();const em=v=>txt(v).toLowerCase();const draft=new Map(D.map(d=>[n(d),d]));const log=new Map(L.map(l=>[n(l),l]));const xset=new Set(X.map(e=>Number(e.Prospect)));\nconst allAddresses=P.map(p=>em(p['Public Email']));const candidates=[];const problems=[];\nfor(let id=76;id<=95;id++){const p=P.find(r=>n(r)===id),d=draft.get(id),l=log.get(id);const issues=[];const to=em(d?.['Send To']);\nif(!p||!d||!l){issues.push('Missing prospect/draft/send-ledger record');problems.push('#'+id+': '+issues.join(','));continue;}\nif(txt(p.Status)!=='Not contacted'||txt(p['First Email Date']))issues.push('Prospect already contacted');\nif(!/^draft\\b/i.test(txt(d['Draft Status']))||txt(d['Sent Date']))issues.push('Draft status/timestamp not unsent');\nif(l['Batch ID']!=='BATCH07-20261027'||txt(l.Status)!=='PENDING'||txt(l['Gmail Message ID'])||txt(l['Sent At ET']))issues.push('Send-log already processed');\nif(txt(l.Disposition)!=='READY')issues.push('Disposition not READY');\nif(to!==em(p['Public Email'])||to!==em(l.Recipient)||!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(to))issues.push('Invalid/mismatched email');\nif(allAddresses.filter(x=>x===to).length!==1)issues.push('Duplicate email');\nif(xset.has(id))issues.push('Contact exception');\nif(!txt(d.Subject)||!txt(d['Personalized Email Body'])||!txt(d['Personalized Email Body']).toLowerCase().includes('unsubscribe'))issues.push('Invalid/empty draft');\nif(/unsubscribe|opt.?out|do not contact|hard bounce|no such user|mailbox full|undeliver|blocked|connection refused|not interested/i.test([p.Outcome,p.Notes,p['Next Action']].map(txt).join(' ')))issues.push('Suppression text');\nif(issues.length)problems.push('#'+id+': '+issues.join(', '));\nelse candidates.push({batch_id:'BATCH07-20261027',prospect_id:id,business:txt(p.Business),to,subject:txt(d.Subject),body:txt(d['Personalized Email Body'])});}\nif(problems.length||candidates.length!==20)throw Error('ABORT entire batch before Gmail: '+problems.join(' | ')+'; safe_count='+candidates.length);\nconst gmail_query='in:anywhere {'+candidates.map(c=>'to:'+c.to+' from:'+c.to).join(' ')+'}';\nreturn [{json:{gmail_query,candidates,expected:20,batch_id:'BATCH07-20261027'}}];\n"
      }
    },
