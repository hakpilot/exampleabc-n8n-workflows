      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst queue=$('Prepare Queue and Gmail Search').first().json;\nconst messages=$input.all().map(i=>i.json).filter(m=>m.id||m.threadId);\nif(messages.length)throw Error('Existing Gmail communications found for pending prospects; hold batch. Count='+messages.length);\nif(!Array.isArray(queue.candidates)||queue.candidates.length!==20)throw Error('Expected 20 validated prospective recipients, got '+(queue.candidates?.length??0));\nreturn [{json:{status:'QA15_PASS',eligible:queue.candidates.length,batch_id:'BATCH07-20261027',gmail_previous_messages:0,approved:false,sent:false}}];"
      }
    },
